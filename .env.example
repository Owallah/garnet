# ---- Sanity (public values only) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# ---- Sanity (server only, never NEXT_PUBLIC_) ----
SANITY_API_READ_TOKEN=
# Editor-scoped token, used only by `npm run seed`. Not needed at runtime.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that hits /api/revalidate
SANITY_REVALIDATE_SECRET=

# ---- Email (Brevo) ----
# SMTP & API -> API Keys. Server-side only.
BREVO_API_KEY=
# true in development: Brevo validates the request and drops the message,
# so forms can be exercised without a verified sender or using the quota.
EMAIL_SANDBOX=false
CONTACT_EMAIL=
FINANCING_EMAIL=
INVESTMENT_EMAIL=
# Must be a sender Brevo has verified, or the send is rejected.
EMAIL_FROM="Garnet Solutions <no-reply@example.com>"

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://example.com

# ---- Rate limiting (optional; falls back to in-memory in dev) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Spam protection (optional) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=